    // ==========================================
    // Environment Modal
    // ==========================================
    var modalEnvId = '';

    function renderEnvModal() {
        var sel = $('api-modal-env-select');
        sel.innerHTML = state.environments.map(function (env) {
            return '<option value="' + escapeHtml(env.id) + '">' + escapeHtml(env.name) + '</option>';
        }).join('');
        if (!modalEnvId || !state.environments.find(function (e) { return e.id === modalEnvId; })) {
            modalEnvId = state.activeEnvId || (state.environments[0] && state.environments[0].id) || '';
        }
        sel.value = modalEnvId;
        var env = state.environments.find(function (e) { return e.id === modalEnvId; });
        var tbody = $('api-modal-vars-tbody');
        if (!env || !env.variables.length) {
            tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#94a3b8;font-size:12px;padding:10px;">변수가 없습니다.</td></tr>';
            return;
        }
        tbody.innerHTML = env.variables.map(function (v, idx) {
            return '<tr data-var-idx="' + idx + '">' +
                '<td><input type="checkbox" data-var-field="enabled" ' + (v.enabled ? 'checked' : '') + '></td>' +
                '<td><input type="text" class="portal-api-kv-input" data-var-field="key" value="' + escapeHtml(v.key) + '" placeholder="변수명"></td>' +
                '<td><input type="text" class="portal-api-kv-input" data-var-field="value" value="' + escapeHtml(v.value) + '" placeholder="값"></td>' +
                '<td><button type="button" class="portal-api-icon-btn is-del" data-var-del="' + idx + '">×</button></td>' +
                '</tr>';
        }).join('');
    }

    $('api-env-manage-btn').addEventListener('click', function () {
        modalEnvId = state.activeEnvId;
        renderEnvModal();
        $('api-env-modal').hidden = false;
    });
    $('api-env-close').addEventListener('click', function () { $('api-env-modal').hidden = true; });
    $('api-modal-env-select').addEventListener('change', function (e) {
        modalEnvId = e.target.value;
        renderEnvModal();
    });
    $('api-modal-env-add').addEventListener('click', function () {
        var name = prompt('새 환경 이름:', '운영 (Production)');
        if (!name || !name.trim()) return;
        var now = new Date().toISOString();
        var env = { id: uid('env'), name: name.trim(), variables: [], createdAt: now, updatedAt: now };
        putItem(STORES.ENVIRONMENTS, env).then(reloadAllData).then(function () {
            modalEnvId = env.id;
            renderEnvModal();
        });
    });
    $('api-modal-env-del').addEventListener('click', function () {
        if (!modalEnvId || state.environments.length <= 1) {
            showToast('최소 1개의 환경은 유지해야 합니다.');
            return;
        }
        deleteItem(STORES.ENVIRONMENTS, modalEnvId).then(reloadAllData).then(function () {
            modalEnvId = state.environments[0].id;
            renderEnvModal();
        });
    });
    $('api-modal-var-add').addEventListener('click', function () {
        var env = state.environments.find(function (e) { return e.id === modalEnvId; });
        if (!env) return;
        env.variables.push({ id: uid('v'), key: '', value: '', enabled: true });
        renderEnvModal();
    });
    $('api-modal-vars-tbody').addEventListener('input', function (e) {
        var tr = e.target.closest('tr[data-var-idx]');
        var env = state.environments.find(function (x) { return x.id === modalEnvId; });
        if (!tr || !env) return;
        var v = env.variables[Number(tr.dataset.varIdx)];
        var field = e.target.dataset.varField;
        v[field] = field === 'enabled' ? e.target.checked : e.target.value;
    });
    $('api-modal-vars-tbody').addEventListener('click', function (e) {
        var del = e.target.closest('[data-var-del]');
        var env = state.environments.find(function (x) { return x.id === modalEnvId; });
        if (!del || !env) return;
        env.variables.splice(Number(del.dataset.varDel), 1);
        renderEnvModal();
    });
    $('api-env-save-close').addEventListener('click', function () {
        var env = state.environments.find(function (e) { return e.id === modalEnvId; });
        if (!env) { $('api-env-modal').hidden = true; return; }
        putItem(STORES.ENVIRONMENTS, env).then(reloadAllData).then(function () {
            state.activeEnvId = env.id;
            renderEnvSelect();
            $('api-env-modal').hidden = true;
            showToast('환경 변수가 저장되었습니다.');
        }).catch(function (err) {
            $('api-env-modal').hidden = true;
            showToast('저장 오류: ' + (err && err.message ? err.message : err));
        });
    });

    // Init
    openDB()
        .then(function () { return getAllFromStore(STORES.COLLECTIONS); })
        .then(function (cols) {
            if (!cols.length) return createInitialSampleData();
        })
        .then(reloadAllData)
        .then(function () {
            loadRequestIntoEditor(state.requests[0] || null);
        })
        .catch(function (err) {
            $('api-editor-empty').hidden = false;
            $('api-editor-empty').textContent = '초기화 오류: ' + err.message;
        });
}());
</script>
