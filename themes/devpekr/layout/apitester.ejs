    $('api-import-btn').addEventListener('click', function () { $('api-import-input').click(); });
    $('api-import-input').addEventListener('change', function (e) {
        var file = e.target.files[0];
        if (!file) return;
        file.text().then(function (txt) {
            var data = JSON.parse(txt);
            if (!data || !Array.isArray(data.collections)) throw new Error('유효하지 않은 JSON 형식');
            var tasks = [];
            data.collections.forEach(function (c) { tasks.push(putItem(STORES.COLLECTIONS, c)); });
            (data.folders || []).forEach(function (f) { tasks.push(putItem(STORES.FOLDERS, f)); });
            (data.requests || []).forEach(function (r) { tasks.push(putItem(STORES.REQUESTS, r)); });
            (data.environments || []).forEach(function (env) { tasks.push(putItem(STORES.ENVIRONMENTS, env)); });
            return Promise.all(tasks);
        }).then(reloadAllData).then(function () {
            if (!state.currentRequest && state.requests.length) loadRequestIntoEditor(state.requests[0]);
            showToast('데이터를 가져왔습니다.');
        }).catch(function (err) {
            showToast('가져오기 실패: ' + err.message);
        });
