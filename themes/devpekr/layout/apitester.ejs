    document.querySelector('.portal-api-tab-body').addEventListener('input', function (e) {
        var tr = e.target.closest('tr[data-kv-kind]');
        if (!tr || !state.currentRequest) return;
        var kind = tr.dataset.kvKind;
        var idx = Number(tr.dataset.kvIdx);
        var field = e.target.dataset.kvField;
        var list = kind === 'params' ? state.currentRequest.params
            : kind === 'headers' ? state.currentRequest.headers
            : kind === 'urlencoded' ? state.currentRequest.body.urlencodedData
            : state.currentRequest.body.formData;
        if (!list[idx]) return;
        list[idx][field] = field === 'enabled' ? e.target.checked : e.target.value;
        if (kind === 'params') syncUrlFromParams();
        else { updateTabBadges(); debouncedSave(); }
    });

    document.querySelector('.portal-api-tab-body').addEventListener('click', function (e) {
        var delBtn = e.target.closest('[data-kv-del]');
        if (!delBtn || !state.currentRequest) return;
        var tr = delBtn.closest('tr[data-kv-kind]');
        var kind = tr.dataset.kvKind;
        var idx = Number(delBtn.dataset.kvDel);
        var list = kind === 'params' ? state.currentRequest.params
            : kind === 'headers' ? state.currentRequest.headers
            : kind === 'urlencoded' ? state.currentRequest.body.urlencodedData
            : state.currentRequest.body.formData;
        list.splice(idx, 1);
        renderKvTable(tr.closest('tbody').id, list, kind);
        if (kind === 'params') syncUrlFromParams();
        else { updateTabBadges(); debouncedSave(); }
