<%- css('css/portal-charmap') %>

<div class="portal-charmap-page" id="top">
    <nav class="portal-breadcrumb" aria-label="현재 위치">
        <a href="<%- url_for() %>">홈</a><span aria-hidden="true">›</span><a href="<%- url_for('categories/앱/') %>">앱</a><span aria-hidden="true">›</span><span>특수문자 · 이모지 모음</span>
    </nav>

    <header class="portal-charmap-hero">
        <span class="portal-section-kicker">ONLINE DEVELOPER TOOL</span>
        <h1>특수문자 · 이모지 · 유니코드 모음</h1>
        <p>기호, 이모지, 이모티콘, 아스키아트, 유니코드 전체 블록, 결합문자, 영문 글꼴 변환, 문자 정보, 한글 특수문자를 한곳에서 클릭 한 번으로 복사할 수 있습니다.</p>
    </header>

    <div class="portal-cm-bar">
        <div class="portal-cm-bar-block">
            <label for="cm-search">특수문자 · 키워드 빠른 검색</label>
            <div class="portal-cm-input-row">
                <input id="cm-search" class="portal-cm-input" type="search" placeholder="예: 화살표, 별, 하트, 체크, 수학, 박스, 한글, arrow" autocomplete="off">
                <button type="button" class="portal-cm-btn-sub" id="cm-search-clear">초기화</button>
            </div>
        </div>
        <div class="portal-cm-bar-block">
            <label for="cm-scratch">조합 입력창 (클릭 시 자동 복사 + 여기에 이어붙이기)</label>
            <div class="portal-cm-input-row">
                <input id="cm-scratch" class="portal-cm-input" type="text" placeholder="문자를 클릭하면 이곳에 조합됩니다">
                <button type="button" class="portal-cm-btn" id="cm-scratch-copy">전체 복사</button>
                <button type="button" class="portal-cm-btn-sub" id="cm-scratch-clear">비우기</button>
            </div>
        </div>
    </div>

    <div class="portal-cm-tabs" role="tablist" aria-label="문자 분류">
        <button type="button" class="portal-cm-tab is-active" data-cm-tab="symbols">기호</button>
        <button type="button" class="portal-cm-tab" data-cm-tab="emoji">이모지</button>
        <button type="button" class="portal-cm-tab" data-cm-tab="emoticon">이모티콘</button>
        <button type="button" class="portal-cm-tab" data-cm-tab="ascii">아스키아트</button>
        <button type="button" class="portal-cm-tab" data-cm-tab="unicode">유니코드</button>
        <button type="button" class="portal-cm-tab" data-cm-tab="combining">결합문자</button>
        <button type="button" class="portal-cm-tab" data-cm-tab="font">글꼴변환</button>
        <button type="button" class="portal-cm-tab" data-cm-tab="info">문자정보</button>
        <button type="button" class="portal-cm-tab" data-cm-tab="hangul">한글</button>
        <button type="button" class="portal-cm-tab" data-cm-tab="my">MY</button>
    </div>

    <div id="cm-search-results" class="portal-cm-pane" hidden>
        <section class="portal-cm-section">
            <h2>검색 결과 <span id="cm-search-count">0개</span></h2>
            <div class="portal-cm-grid" id="cm-search-grid"></div>
        </section>
    </div>

    <div class="portal-cm-pane" data-cm-pane="symbols"></div>
    <div class="portal-cm-pane" data-cm-pane="emoji" hidden></div>
    <div class="portal-cm-pane" data-cm-pane="emoticon" hidden></div>
    <div class="portal-cm-pane" data-cm-pane="ascii" hidden></div>
    <div class="portal-cm-pane" data-cm-pane="unicode" hidden></div>

    <div class="portal-cm-pane" data-cm-pane="combining" hidden>
        <div class="portal-cm-toolbar">
            <input id="cm-comb-input" class="portal-cm-input" type="text" value="dev.pe.kr 특수문자" placeholder="결합문자를 적용할 텍스트를 입력하세요">
        </div>
        <div class="portal-cm-font-list" id="cm-comb-list"></div>
    </div>

    <div class="portal-cm-pane" data-cm-pane="font" hidden>
        <div class="portal-cm-toolbar">
            <input id="cm-font-input" class="portal-cm-input" type="text" value="dev.pe.kr Hello 2026!" placeholder="변환할 영문/숫자를 입력하세요">
        </div>
        <div class="portal-cm-font-list" id="cm-font-list"></div>
    </div>

    <div class="portal-cm-pane" data-cm-pane="info" hidden>
        <div class="portal-cm-toolbar">
            <input id="cm-info-input" class="portal-cm-input" type="text" value="★한글🚀" placeholder="분석할 문자나 이모지를 입력하세요">
        </div>
        <div class="portal-cm-info-grid" id="cm-info-grid"></div>
    </div>

    <div class="portal-cm-pane" data-cm-pane="hangul" hidden></div>

    <div class="portal-cm-pane" data-cm-pane="my" hidden>
        <section class="portal-cm-section">
            <h2>최근 복사한 문자 (MY) <button type="button" class="portal-cm-btn-sub" id="cm-my-clear" style="height:28px;font-size:12px;">기록 삭제</button></h2>
            <div class="portal-cm-grid" id="cm-my-grid"></div>
        </section>
    </div>
</div>

<div class="portal-cm-toast" id="cm-toast" role="status" aria-live="polite"></div>

