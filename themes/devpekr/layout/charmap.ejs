    var $ = function (id) { return document.getElementById(id); };
    var toastTimer = null;
    var activeTab = 'symbols';
    var RECENT_KEY = 'devpekr_charmap_recent';

    function showToast(text) {
        var toast = $('cm-toast');
        toast.textContent = text;
        toast.classList.add('is-show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toast.classList.remove('is-show'); }, 1800);
    }

    function getRecent() {
        try { return JSON.parse(localStorage.getItem(RECENT_KEY) || '[]'); }
        catch (e) { return []; }
    }

    function addRecent(ch) {
        var list = getRecent().filter(function (x) { return x !== ch; });
        list.unshift(ch);
        if (list.length > 40) list = list.slice(0, 40);
        try { localStorage.setItem(RECENT_KEY, JSON.stringify(list)); } catch (e) {}
        renderRecent();
    }

    function copyText(text, label) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function () {
                showToast(label || ('복사됨: ' + text));
            }).catch(function () {
                showToast('복사 완료');
            });
        }
    }

    function copyChar(ch) {
        $('cm-scratch').value += ch;
        addRecent(ch);
        var cp = ch.codePointAt(0);
        var uHex = cp ? 'U+' + cp.toString(16).toUpperCase().padStart(4, '0') : '';
        copyText(ch, '복사됨: ' + ch + (uHex ? ' (' + uHex + ')' : ''));
    }

    function makeCell(ch, tooltipCode) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'portal-cm-cell';
        btn.title = ch + (tooltipCode ? ' (' + tooltipCode + ')' : '') + ' — 클릭하여 복사';
        var mainSpan = document.createElement('span');
        mainSpan.textContent = ch;
        btn.appendChild(mainSpan);
        btn.addEventListener('click', function () { copyChar(ch); });
        return btn;
    }

    function renderGroups(container, groups, wide) {
        container.innerHTML = '';
        groups.forEach(function (g) {
            var sec = document.createElement('section');
            sec.className = 'portal-cm-section';
            var h2 = document.createElement('h2');
            h2.innerHTML = g.title + ' <span>' + g.items.length + '개</span>';
            var grid = document.createElement('div');
            grid.className = 'portal-cm-grid' + (wide ? ' is-wide' : '');
            g.items.forEach(function (item) {
                var cp = item.codePointAt(0);
                var label = (!wide && item.length <= 2 && cp) ? 'U+' + cp.toString(16).toUpperCase() : '';
                grid.appendChild(makeCell(item, label));
            });
            sec.appendChild(h2);
            sec.appendChild(grid);
            container.appendChild(sec);
        });
    }

    function renderAsciiArts() {
        var container = document.querySelector('[data-cm-pane="ascii"]');
        var sec = document.createElement('section');
        sec.className = 'portal-cm-section';
        var h2 = document.createElement('h2');
        h2.innerHTML = '아스키아트 모음 <span>' + ASCII_ARTS.length + '개</span>';
        var grid = document.createElement('div');
        grid.className = 'portal-cm-ascii-grid';
        ASCII_ARTS.forEach(function (item) {
            var card = document.createElement('div');
            card.className = 'portal-cm-ascii-card';
            var head = document.createElement('div');
            head.className = 'portal-cm-ascii-head';
            var title = document.createElement('strong');
            title.textContent = item.title;
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'portal-cm-btn-sub';
            btn.style.height = '28px';
            btn.textContent = '복사';
            btn.addEventListener('click', function () { copyText(item.art, '아스키아트 복사됨: ' + item.title); });
            head.appendChild(title);
            head.appendChild(btn);
            var pre = document.createElement('pre');
            pre.textContent = item.art;
            card.appendChild(head);
            card.appendChild(pre);
            grid.appendChild(card);
        });
        sec.appendChild(h2);
        sec.appendChild(grid);
        container.appendChild(sec);
    }

    function renderUnicodeRange(grid, start, end, limitEnd, moreBtn) {
        for (var cp = start; cp <= limitEnd; cp++) {
            if (cp >= 0xD800 && cp <= 0xDFFF) continue;
            var ch = String.fromCodePoint(cp);
            grid.appendChild(makeCell(ch, "U+" + cp.toString(16).toUpperCase()));
        }
        if (limitEnd < end) {
            moreBtn.hidden = false;
            moreBtn.textContent = "더 보기 (" + (end - limitEnd) + "자 남음)";
            moreBtn.onclick = function () {
                var nextStart = limitEnd + 1;
                var nextEnd = Math.min(end, nextStart + 511);
                limitEnd = nextEnd;
                renderUnicodeRange(grid, nextStart, end, nextEnd, moreBtn);
            };
        } else {
            moreBtn.hidden = true;
        }
    }

    function renderAllUnicodeBlocks() {
        var container = document.querySelector('[data-cm-pane="unicode"]');
        container.innerHTML = '';

        var bar = document.createElement('div');
        bar.className = 'portal-cm-toolbar';
        bar.innerHTML = '<input id="cm-u-filter" class="portal-cm-input" type="search" placeholder="유니코드 블록 이름 또는 코드 검색 (총 ' + UNICODE_BLOCKS.length + '개 블록, 예: 화살표, 수학, 한글, 2190)">';
        container.appendChild(bar);

        var list = document.createElement('div');
        list.className = 'portal-cm-ublock-list';
        container.appendChild(list);

        var observer = null;

        function buildList(filter) {
            if (observer) observer.disconnect();
            list.innerHTML = '';
            var q = (filter || '').trim().toLowerCase();
            var loaders = new WeakMap();
            if ('IntersectionObserver' in window) {
                observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            var fn = loaders.get(entry.target);
                            if (fn) {
                                fn();
                                observer.unobserve(entry.target);
                            }
                        }
                    });
                }, { rootMargin: '600px 0px' });
            }

            UNICODE_BLOCKS.forEach(function (b, idx) {
                if (q && (b.title + " " + b.range).toLowerCase().indexOf(q) === -1) return;
                var card = document.createElement('div');
                card.className = 'portal-cm-ublock';

                var head = document.createElement('button');
                head.type = 'button';
                head.className = 'portal-cm-ublock-head';
                var total = b.end - b.start + 1;
                head.innerHTML = "<strong>" + b.title + "</strong><span>" + b.range + " · " + total.toLocaleString() + "자</span>";

                var body = document.createElement('div');
                body.className = 'portal-cm-ublock-body';

                var grid = document.createElement('div');
                grid.className = 'portal-cm-grid';
                var moreBtn = document.createElement('button');
                moreBtn.type = 'button';
                moreBtn.className = 'portal-cm-btn-sub';
                moreBtn.style.marginTop = '12px';
                moreBtn.style.height = '34px';
                moreBtn.hidden = true;

                body.appendChild(grid);
                body.appendChild(moreBtn);

                var rendered = false;
                function openBody() {
                    if (!rendered) {
                        rendered = true;
                        var firstEnd = Math.min(b.end, b.start + 511);
                        renderUnicodeRange(grid, b.start, b.end, firstEnd, moreBtn);
                    }
                }

                if (idx < 8 || !observer) {
                    openBody();
                } else {
                    loaders.set(card, openBody);
                    observer.observe(card);
                }

                head.addEventListener('click', function () {
                    body.hidden = !body.hidden;
                    if (!body.hidden) openBody();
                });

                card.appendChild(head);
                card.appendChild(body);
                list.appendChild(card);
            });
        }

        buildList('');
        container.querySelector('#cm-u-filter').addEventListener('input', function (e) {
            buildList(e.target.value);
        });
    }

    function renderCombining() {
        var input = $('cm-comb-input').value || 'dev.pe.kr';
        var list = $('cm-comb-list');
        list.innerHTML = '';
        COMBINING_STYLES.forEach(function (style) {
            var converted = Array.from(input).map(function (c) {
                return c === ' ' ? ' ' : c + style.mark;
            }).join('');
            var card = document.createElement('div');
            card.className = 'portal-cm-font-card';
            var left = document.createElement('div');
            var sm = document.createElement('small');
            sm.textContent = style.name;
            var st = document.createElement('strong');
            st.textContent = converted;
            left.appendChild(sm);
            left.appendChild(st);
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'portal-cm-btn-sub';
            btn.style.height = '34px';
            btn.textContent = '복사';
            btn.addEventListener('click', function () { copyText(converted, '결합문자 복사됨'); });
            card.appendChild(left);
            card.appendChild(btn);
            list.appendChild(card);
        });
    }

    function transformText(text, map) {
        return Array.from(text).map(function (c) {
            var code = c.charCodeAt(0);
            if (code >= 65 && code <= 90) return String.fromCodePoint(map.upper + (code - 65));
            if (code >= 97 && code <= 122) return String.fromCodePoint(map.lower + (code - 97));
            if (map.digit !== null && code >= 48 && code <= 57) return String.fromCodePoint(map.digit + (code - 48));
            return c;
        }).join('');
    }

    function renderFontTransforms() {
        var input = $('cm-font-input').value || 'dev.pe.kr';
        var list = $('cm-font-list');
        list.innerHTML = '';
        FONT_MAPS.forEach(function (map) {
            var converted = transformText(input, map);
            var card = document.createElement('div');
            card.className = 'portal-cm-font-card';
            var left = document.createElement('div');
            var sm = document.createElement('small');
            sm.textContent = map.name;
            var st = document.createElement('strong');
            st.textContent = converted;
            left.appendChild(sm);
            left.appendChild(st);
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'portal-cm-btn-sub';
            btn.style.height = '34px';
            btn.textContent = '복사';
            btn.addEventListener('click', function () { copyText(converted, '변환 텍스트 복사됨'); });
            card.appendChild(left);
            card.appendChild(btn);
            list.appendChild(card);
        });
    }

    function renderCharInfo() {
        var text = $('cm-info-input').value;
        var grid = $('cm-info-grid');
        grid.innerHTML = '';
        Array.from(text).slice(0, 24).forEach(function (ch) {
            var cp = ch.codePointAt(0);
            var hex = cp.toString(16).toUpperCase().padStart(4, '0');
            var card = document.createElement('div');
            card.className = 'portal-cm-info-card';
            card.innerHTML =
                '<div class="char-big">' + ch.replace(/</g, '&lt;') + '</div>' +
                '<div class="portal-cm-info-row"><span>Unicode</span><code>U+' + hex + '</code></div>' +
                '<div class="portal-cm-info-row"><span>HTML Entity</span><code>&amp;#' + cp + ';</code></div>' +
                '<div class="portal-cm-info-row"><span>CSS Escape</span><code>\\' + hex + '</code></div>' +
                '<div class="portal-cm-info-row"><span>JS Escape</span><code>\\u{' + hex + '}</code></div>';
            card.querySelectorAll('code').forEach(function (codeEl) {
                codeEl.title = '클릭하여 복사';
                codeEl.addEventListener('click', function () { copyText(codeEl.textContent); });
            });
            grid.appendChild(card);
        });
    }

    function renderRecent() {
        var grid = $('cm-my-grid');
        var list = getRecent();
        grid.innerHTML = '';
        if (!list.length) {
            grid.innerHTML = '<p style="color:#64748b;font-size:14px;grid-column:1/-1;">아직 복사한 문자가 없습니다. 원하는 기호나 이모지를 클릭하면 이곳에 자동으로 저장됩니다.</p>';
            return;
        }
        list.forEach(function (ch) {
            var cp = ch.codePointAt(0);
            grid.appendChild(makeCell(ch, ch.length <= 2 && cp ? 'U+' + cp.toString(16).toUpperCase() : ''));
        });
    }

    function handleSearch() {
        var q = $('cm-search').value.trim().toLowerCase();
        var resultsPane = $('cm-search-results');
        if (!q) {
            resultsPane.hidden = true;
            document.querySelectorAll('[data-cm-pane]').forEach(function (p) {
                p.hidden = p.dataset.cmPane !== activeTab;
            });
            return;
        }
        resultsPane.hidden = false;
        document.querySelectorAll('[data-cm-pane]').forEach(function (p) { p.hidden = true; });
        var grid = $('cm-search-grid');
        grid.innerHTML = '';
        var hits = [];
        SYMBOL_GROUPS.concat(EMOJI_GROUPS, EMOTICON_GROUPS, HANGUL_GROUPS).forEach(function (g) {
            var groupMatch = (g.title + ' ' + g.keys).toLowerCase().indexOf(q) !== -1;
            g.items.forEach(function (item) {
                if (groupMatch || item.toLowerCase().indexOf(q) !== -1) {
                    if (hits.indexOf(item) === -1) hits.push(item);
                }
            });
        });
        $('cm-search-count').textContent = hits.length + '개';
        hits.forEach(function (item) {
            var cp = item.codePointAt(0);
            grid.appendChild(makeCell(item, item.length <= 2 && cp ? 'U+' + cp.toString(16).toUpperCase() : ''));
        });
    }

    document.querySelectorAll('[data-cm-tab]').forEach(function (tab) {
        tab.addEventListener('click', function () {
            activeTab = tab.dataset.cmTab;
            $('cm-search').value = '';
            $('cm-search-results').hidden = true;
            document.querySelectorAll('[data-cm-tab]').forEach(function (t) {
                t.classList.toggle('is-active', t === tab);
            });
            document.querySelectorAll('[data-cm-pane]').forEach(function (p) {
                p.hidden = p.dataset.cmPane !== activeTab;
            });
        });
    });

    $('cm-search').addEventListener('input', handleSearch);
    $('cm-search-clear').addEventListener('click', function () {
        $('cm-search').value = '';
        handleSearch();
    });
    $('cm-scratch-copy').addEventListener('click', function () {
        var v = $('cm-scratch').value;
        if (!v) return;
        copyText(v, '조합 문자열을 복사했습니다.');
    });
    $('cm-scratch-clear').addEventListener('click', function () { $('cm-scratch').value = ''; });
    $('cm-comb-input').addEventListener('input', renderCombining);
    $('cm-font-input').addEventListener('input', renderFontTransforms);
    $('cm-info-input').addEventListener('input', renderCharInfo);
    $('cm-my-clear').addEventListener('click', function () {
        try { localStorage.removeItem(RECENT_KEY); } catch (e) {}
        renderRecent();
        showToast('최근 복사 기록을 비웠습니다.');
    });

    renderGroups(document.querySelector('[data-cm-pane="symbols"]'), SYMBOL_GROUPS, false);
    renderGroups(document.querySelector('[data-cm-pane="emoji"]'), EMOJI_GROUPS, false);
    renderGroups(document.querySelector('[data-cm-pane="emoticon"]'), EMOTICON_GROUPS, true);
    renderGroups(document.querySelector('[data-cm-pane="hangul"]'), HANGUL_GROUPS, false);
    renderAsciiArts();
    renderAllUnicodeBlocks();
    renderCombining();
    renderFontTransforms();
    renderCharInfo();
    renderRecent();
}());
</script>