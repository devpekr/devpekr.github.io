<!DOCTYPE html>
<html lang="<%= seo_lang() %>">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= seo_title(page) %></title>
    <%- seo_meta_tags(page) %>
    <%- meta(page) %>
    <%- seo_json_ld(page) %>

    <link rel="stylesheet" href="/css/callout.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Google tag (gtag.js / GTM-MXPVTTT7) -->
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-MXPVTTT7"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1462073936083515"
         crossorigin="anonymous"></script>

    <%- partial('pwa/index') %>
    <% if (theme.plugins && theme.plugins.bing_site_verification && !(config.seo && config.seo.verification && config.seo.verification.bing)) { %>
      <meta name="msvalidate.01" content="<%- theme.plugins.bing_site_verification %>" />
    <% } %>

    <% if (theme.customize && theme.customize.social_links && theme.customize.social_links.rss) { %>
        <link rel="alternate" href="<%- theme.customize.social_links.rss %>" title="<%= config.title %>" type="application/atom+xml" />
    <% } %>

    <% if (theme.customize.favicon) { %>
        <link rel="icon" href="<%- url_for(theme.customize.favicon) %>" />
    <% } %>

    <%- css('libs/font-awesome/css/font-awesome.min') %>
    <%- css('libs/titillium-web/styles') %>
    <%- css('libs/source-code-pro/styles') %>

    <%- css('css/style') %>
    <%- css('css/portfolio') %>
    <%- css('css/portal-listings') %>
    <%- css('css/portal-static') %>
    <%- css('css/portal-type') %>

    <%- js('libs/jquery/3.5.0/jquery.min') %>
    <%- partial('plugin/scripts', { isHead: true }) %>
</head>
