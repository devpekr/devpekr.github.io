<%
var appCategory = site.categories.findOne({ name: '앱' });
var appPosts = appCategory ? appCategory.posts.sort('date', -1).toArray() : [];
var visitorData = site.data && site.data.visitors ? site.data.visitors : {};
var todayVisitors = typeof visitorData.todayVisitors === 'number' ? visitorData.todayVisitors.toLocaleString('ko-KR') : '-';
var visitorUpdatedTitle = visitorData.updatedAt ? ('기준: ' + visitorData.updatedAt) : 'GA4 연동 대기 중';
%>

<div class="portal-home" id="top">
    <main>
        <section class="portal-width portal-apps-section" id="apps">
            <header class="portal-apps-hero">
                <div>
                    <span class="portal-section-kicker">WORKPLACE WEB APPS</span>
                    <h1>업무용 웹 앱</h1>
                    <p>설치나 로그인 없이 브라우저에서 바로 실행할 수 있는 실무 도구 모음입니다. 최신 등록된 앱이 상단에 표시됩니다.</p>
                </div>
                <div class="portal-apps-stats">
                    <div class="portal-apps-count" aria-label="오늘 방문자 수" title="<%= visitorUpdatedTitle %>">
                        <strong><%= todayVisitors %></strong>
                        <span>TODAY</span>
                    </div>
                    <div class="portal-apps-count" aria-label="등록된 앱 수">
                        <strong><%= appPosts.length %></strong>
                        <span>APPS</span>
                    </div>
                </div>
            </header>

            <div class="portal-app-grid">
                <% appPosts.forEach(function(post, index) {
                    var postImage = thumbnail(post) || url_for('images/ai-developer.png');
                    var desc = post.description || strip_html(post.excerpt || post.content).slice(0, 110);
                %>
                <article class="portal-app-card">
                    <a href="<%- url_for(post.path) %>">
                        <div class="portal-app-thumb">
                            <img src="<%- postImage %>" alt="<%= post.title %>" <%- index < 4 ? 'fetchpriority="high"' : 'loading="lazy"' %>>
                            <% if (index === 0) { %><span class="portal-app-new">NEW</span><% } %>
                        </div>
                        <div class="portal-app-body">
                            <span class="portal-app-date"><%= date(post.date, 'YYYY.MM.DD') %></span>
                            <h2><%= post.title %></h2>
                            <% if (desc) { %><p class="portal-app-desc"><%= desc %></p><% } %>
                            <div class="portal-app-foot">
                                <span>바로 실행</span>
                                <span aria-hidden="true">→</span>
                            </div>
                        </div>
                    </a>
                </article>
                <% }); %>
            </div>
        </section>
    </main>
</div>
