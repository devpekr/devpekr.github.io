<%- css('css/portal-lotto') %>

<div class="portal-lotto-page" id="top">
    <nav class="portal-breadcrumb" aria-label="현재 위치">
        <a href="<%- url_for() %>">홈</a><span aria-hidden="true">›</span><a href="<%- url_for('categories/앱/') %>">앱</a><span aria-hidden="true">›</span><span>로또번호 생성기</span>
    </nav>

    <header class="portal-lotto-hero">
        <div class="portal-lotto-hero-copy">
            <span class="portal-section-kicker">ONLINE DEVELOPER TOOL</span>
            <h1>로또번호 생성기</h1>
            <p>역대 로또 당첨번호 데이터와 출현빈도·당첨금액·당첨게임수 통계를 바탕으로 가중치 기반 추천번호 10세트를 생성합니다.</p>
        </div>
        <figure class="portal-lotto-hero-art">
            <img src="<%- url_for('images/lotto-generator-cover.png') %>" alt="색색의 로또 공과 번호 통계를 담은 이미지">
        </figure>
    </header>

    <section class="portal-lotto-summary">
        <div class="portal-lotto-metrics">
            <div class="portal-lotto-metric">
                <span>저장 회차</span>
                <strong id="lotto-total-draws">-</strong>
            </div>
            <div class="portal-lotto-metric">
                <span>최신 회차</span>
                <strong id="lotto-latest-draw">-</strong>
            </div>
            <div class="portal-lotto-metric">
                <span>생성 방식</span>
                <strong id="lotto-mode-label">랜덤</strong>
            </div>
        </div>
        <div class="portal-lotto-controls">
            <div class="portal-lotto-modes" role="group" aria-label="추천번호 생성 방식">
                <button type="button" class="is-active" data-lotto-mode="random">랜덤</button>
                <button type="button" data-lotto-mode="count">출현</button>
                <button type="button" data-lotto-mode="prize">금액</button>
                <button type="button" data-lotto-mode="winner">게임수</button>
            </div>
            <button type="button" class="portal-lotto-btn" id="lotto-gen-btn">추천번호 생성</button>
        </div>
    </section>

    <div class="portal-lotto-sections">
        <section class="portal-lotto-panel">
            <div class="portal-lotto-panel-head">
                <h2>1. 추천번호 (10세트)</h2>
                <div style="display:flex;align-items:center;gap:10px;">
                    <span class="portal-lotto-status" id="lotto-copy-status"></span>
                    <button type="button" class="portal-lotto-btn-sub" id="lotto-copy-all">전체 복사</button>
                </div>
            </div>
            <div class="portal-lotto-rec-grid" id="lotto-rec-tbody"></div>
            <div class="portal-lotto-mail-bar">
                <span class="portal-lotto-status" id="lotto-mail-status" role="status" aria-live="polite"></span>
                <input id="lotto-mail-input" class="portal-lotto-mail-input" type="email" placeholder="수신할 이메일 주소 (예: user@example.com)" aria-label="수신할 이메일 주소">
                <button type="button" class="portal-lotto-btn" id="lotto-mail-send">메일 발송</button>
            </div>
        </section>

        <section class="portal-lotto-panel">
            <div class="portal-lotto-panel-head">
                <h2>2. 번호별 통계</h2>
                <div class="portal-lotto-tabs" role="tablist">
                    <button type="button" class="portal-lotto-tab is-active" data-stat-tab="count">출현번호</button>
                    <button type="button" class="portal-lotto-tab" data-stat-tab="prize">당첨금액</button>
                    <button type="button" class="portal-lotto-tab" data-stat-tab="winner">당첨게임수</button>
                </div>
            </div>
            <div class="portal-lotto-table-wrap is-stat">
                <table class="portal-lotto-table">
                    <thead id="lotto-stat-thead"></thead>
                    <tbody id="lotto-stat-tbody"></tbody>
                </table>
            </div>
        </section>

        <section class="portal-lotto-panel">
            <div class="portal-lotto-panel-head">
                <h2>3. 회차별 당첨번호</h2>
                <input id="lotto-draw-search" class="portal-lotto-search" type="search" placeholder="회차 또는 날짜 검색 (예: 1243)">
            </div>
            <div class="portal-lotto-table-wrap">
                <table class="portal-lotto-table">
                    <thead>
                        <tr>
                            <th>회차</th>
                            <th>추첨일</th>
                            <th>당첨번호 (6개)</th>
                            <th>보너스</th>
                            <th class="num">당첨게임수</th>
                            <th class="num">1게임당 당첨금액</th>
                        </tr>
                    </thead>
                    <tbody id="lotto-draw-tbody"></tbody>
                </table>
            </div>
            <div class="portal-lotto-pager">
                <button type="button" class="portal-lotto-btn-sub" id="lotto-prev-page">이전</button>
                <span id="lotto-page-info">1 / 1</span>
                <button type="button" class="portal-lotto-btn-sub" id="lotto-next-page">다음</button>
            </div>
        </section>
    </div>
</div>

<script>
(function () {
    var MODE_LABELS = {
        random: '랜덤 (균등 확률)',
        count: '출현 횟수 가중치',
        prize: '당첨금액 가중치',
        winner: '당첨게임수 가중치'
    };

    var allDraws = [];
    var filteredDraws = [];
    var statRows = [];
    var prizeStatRows = [];
    var winnerStatRows = [];
    var recommendRows = [];
    var activeMode = 'random';
    var activeStatTab = 'count';
    var currentPage = 1;
    var pageSize = 25;

    var $ = function (id) { return document.getElementById(id); };

    function getBallClass(n) {
        if (n <= 10) return 'lotto-ball-orange';
        if (n <= 20) return 'lotto-ball-blue';
        if (n <= 30) return 'lotto-ball-red';
        if (n <= 40) return 'lotto-ball-gray';
        return 'lotto-ball-green';
    }

    function ballHtml(n) {
        return '<span class="lotto-ball ' + getBallClass(n) + '">' + n + '</span>';
    }

    function money(v) {
        return Number(v || 0).toLocaleString('ko-KR') + ' 원';
    }

    function computeStats(draws) {
        var base = Array.from({ length: 45 }, function (_, i) {
            return { number: i + 1, mainCount: 0, bonusCount: 0, totalCount: 0, prizeTotal: 0, winnerTotal: 0 };
        });
        draws.forEach(function (d) {
            var prize = Number(d.prizeAmount || 0);
            var win = Number(d.winnerCount || 0);
            [d.num1, d.num2, d.num3, d.num4, d.num5, d.num6].forEach(function (n) {
                if (n >= 1 && n <= 45) {
                    var s = base[n - 1];
                    s.mainCount += 1;
                    s.totalCount += 1;
                    s.prizeTotal += prize;
                    s.winnerTotal += win;
                }
            });
            if (d.bonusNum >= 1 && d.bonusNum <= 45) {
                var sb = base[d.bonusNum - 1];
                sb.bonusCount += 1;
                sb.totalCount += 1;
                sb.prizeTotal += prize;
                sb.winnerTotal += win;
            }
        });
        statRows = base.slice().sort(function (a, b) { return b.totalCount - a.totalCount || a.number - b.number; });
        prizeStatRows = base.slice().sort(function (a, b) { return b.prizeTotal - a.prizeTotal || b.totalCount - a.totalCount || a.number - b.number; });
        winnerStatRows = base.slice().sort(function (a, b) { return b.winnerTotal - a.winnerTotal || b.totalCount - a.totalCount || a.number - b.number; });
    }

    function renderDraws() {
        var totalPages = Math.max(1, Math.ceil(filteredDraws.length / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;
        var start = (currentPage - 1) * pageSize;
        var slice = filteredDraws.slice(start, start + pageSize);

        var tbody = $('lotto-draw-tbody');
        tbody.innerHTML = slice.map(function (d) {
            var nums = [d.num1, d.num2, d.num3, d.num4, d.num5, d.num6].map(ballHtml).join('');
            return '<tr>' +
                '<td><strong>' + d.drawNo + '</strong></td>' +
                '<td>' + d.drawDate + '</td>' +
                '<td><span class="lotto-ball-group">' + nums + '</span></td>' +
                '<td>' + ballHtml(d.bonusNum) + '</td>' +
                '<td class="num">' + Number(d.winnerCount || 0).toLocaleString('ko-KR') + '</td>' +
                '<td class="num">' + money(d.prizeAmount) + '</td>' +
                '</tr>';
        }).join('');

        $('lotto-page-info').textContent = currentPage + ' / ' + totalPages;
        $('lotto-prev-page').disabled = currentPage <= 1;
        $('lotto-next-page').disabled = currentPage >= totalPages;
    }

    function renderStats() {
        var thead = $('lotto-stat-thead');
        var tbody = $('lotto-stat-tbody');
        if (activeStatTab === 'count') {
            thead.innerHTML = '<tr><th>번호</th><th class="num">당첨번호</th><th class="num">보너스</th><th class="num">합계</th></tr>';
            tbody.innerHTML = statRows.map(function (r) {
                return '<tr><td>' + ballHtml(r.number) + '</td><td class="num">' + r.mainCount + '</td><td class="num">' + r.bonusCount + '</td><td class="num"><strong>' + r.totalCount + '</strong></td></tr>';
            }).join('');
        } else if (activeStatTab === 'prize') {
            thead.innerHTML = '<tr><th>번호</th><th class="num">당첨</th><th class="num">보너스</th><th class="num">합계</th><th class="num">금액합계</th></tr>';
            tbody.innerHTML = prizeStatRows.map(function (r) {
                return '<tr><td>' + ballHtml(r.number) + '</td><td class="num">' + r.mainCount + '</td><td class="num">' + r.bonusCount + '</td><td class="num">' + r.totalCount + '</td><td class="num"><strong>' + money(r.prizeTotal) + '</strong></td></tr>';
            }).join('');
        } else {
            thead.innerHTML = '<tr><th>번호</th><th class="num">당첨</th><th class="num">보너스</th><th class="num">합계</th><th class="num">게임수합계</th></tr>';
            tbody.innerHTML = winnerStatRows.map(function (r) {
                return '<tr><td>' + ballHtml(r.number) + '</td><td class="num">' + r.mainCount + '</td><td class="num">' + r.bonusCount + '</td><td class="num">' + r.totalCount + '</td><td class="num"><strong>' + r.winnerTotal.toLocaleString('ko-KR') + '</strong></td></tr>';
            }).join('');
        }
    }

    function generateWeightedSet(weightRows) {
        var pool = Array.from({ length: 45 }, function (_, idx) {
            var n = idx + 1;
            var matched = weightRows.find(function (r) { return r.number === n; });
            return { number: n, weight: Math.max(1, Number((matched && matched.weight) || 0)) };
        });
        var selected = [];
        while (selected.length < 6 && pool.length > 0) {
            var total = pool.reduce(function (s, r) { return s + r.weight; }, 0);
            var th = Math.random() * total;
            var idx = pool.findIndex(function (r) { th -= r.weight; return th <= 0; });
            var pick = idx >= 0 ? idx : pool.length - 1;
            selected.push(pool.splice(pick, 1)[0].number);
        }
        return selected.sort(function (a, b) { return a - b; });
    }

    function generateOneSet(mode) {
        if (mode === 'count') return generateWeightedSet(statRows.map(function (r) { return { number: r.number, weight: r.totalCount }; }));
        if (mode === 'prize') return generateWeightedSet(prizeStatRows.map(function (r) { return { number: r.number, weight: r.prizeTotal }; }));
        if (mode === 'winner') return generateWeightedSet(winnerStatRows.map(function (r) { return { number: r.number, weight: r.winnerTotal }; }));

        var pool = Array.from({ length: 45 }, function (_, i) { return i + 1; });
        var sel = [];
        while (sel.length < 6) {
            sel.push(pool.splice(Math.floor(Math.random() * pool.length), 1)[0]);
        }
        return sel.sort(function (a, b) { return a - b; });
    }

    function renderRecommendations() {
        recommendRows = [];
        for (var i = 1; i <= 10; i++) {
            recommendRows.push({ id: i, nums: generateOneSet(activeMode) });
        }
        var tbody = $('lotto-rec-tbody');
        tbody.innerHTML = recommendRows.map(function (row) {
            var text = row.nums.map(function (n) { return String(n).padStart(2, '0'); }).join(', ');
            return '<div class="portal-lotto-rec-row">' +
                '<span class="rec-no">' + row.id + '</span>' +
                '<span class="lotto-ball-group">' + row.nums.map(ballHtml).join('') + '</span>' +
                '<button type="button" class="portal-lotto-btn-sub" data-copy-line="' + text + '">복사</button>' +
                '</div>';
        }).join('');

        tbody.querySelectorAll('[data-copy-line]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (navigator.clipboard) navigator.clipboard.writeText(btn.dataset.copyLine);
                $('lotto-copy-status').textContent = '복사됨: ' + btn.dataset.copyLine;
            });
        });
    }

    document.querySelectorAll('[data-lotto-mode]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            activeMode = btn.dataset.lottoMode;
            document.querySelectorAll('[data-lotto-mode]').forEach(function (b) { b.classList.toggle('is-active', b === btn); });
            $('lotto-mode-label').textContent = MODE_LABELS[activeMode] || activeMode;
            renderRecommendations();
        });
    });

    document.querySelectorAll('[data-stat-tab]').forEach(function (tab) {
        tab.addEventListener('click', function () {
            activeStatTab = tab.dataset.statTab;
            document.querySelectorAll('[data-stat-tab]').forEach(function (t) { t.classList.toggle('is-active', t === tab); });
            renderStats();
        });
    });

    $('lotto-gen-btn').addEventListener('click', renderRecommendations);
    $('lotto-copy-all').addEventListener('click', function () {
        var allText = recommendRows.map(function (r) {
            return r.id + '게임: ' + r.nums.map(function (n) { return String(n).padStart(2, '0'); }).join(', ');
        }).join('\n');
        if (navigator.clipboard) navigator.clipboard.writeText(allText);
        $('lotto-copy-status').textContent = '10세트 전체를 복사했습니다.';
    });

    function setMailStatus(message, isError) {
        var el = $('lotto-mail-status');
        el.textContent = message;
        el.classList.toggle('is-error', Boolean(isError));
    }

    function sendRecommendationsMail() {
        var input = $('lotto-mail-input');
        var btn = $('lotto-mail-send');
        var recipientEmail = input.value.trim();

        if (!recommendRows.length) {
            setMailStatus('먼저 추천번호를 생성해주세요.', true);
            return;
        }
        if (!recipientEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(recipientEmail)) {
            setMailStatus('올바른 이메일 주소를 입력해주세요.', true);
            input.focus();
            return;
        }

        var recommendations = recommendRows.map(function (row) {
            return {
                num1: row.nums[0],
                num2: row.nums[1],
                num3: row.nums[2],
                num4: row.nums[3],
                num5: row.nums[4],
                num6: row.nums[5]
            };
        });

        btn.disabled = true;
        btn.textContent = '발송 중...';
        setMailStatus('메일을 발송하고 있습니다...', false);

        fetch(LOTTO_API_BASE_URL + '/api/toyproject/lotto/mail', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                recipientEmail: recipientEmail,
                recommendations: recommendations
            })
        })
            .then(function (res) {
                return res.json().catch(function () { return {}; }).then(function (data) {
                    if (!res.ok) {
                        throw new Error((data && (data.message || data.error)) || '메일 발송 실패');
                    }
                    return data;
                });
            })
            .then(function (data) {
                var to = (data && data.to) || recipientEmail;
                var sentCount = (data && data.sentCount != null) ? data.sentCount : recommendations.length;
                setMailStatus(to + ' 으로 ' + sentCount + '세트를 발송했습니다.', false);
            })
            .catch(function (err) {
                setMailStatus((err && err.message) || '메일 발송 실패', true);
            })
            .finally(function () {
                btn.disabled = false;
                btn.textContent = '메일 발송';
            });
    }

    $('lotto-mail-send').addEventListener('click', sendRecommendationsMail);
    $('lotto-mail-input').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            sendRecommendationsMail();
        }
    });

    $('lotto-draw-search').addEventListener('input', function (e) {
        var q = e.target.value.trim();
        filteredDraws = q ? allDraws.filter(function (d) {
            return String(d.drawNo).indexOf(q) !== -1 || d.drawDate.indexOf(q) !== -1;
        }) : allDraws;
        currentPage = 1;
        renderDraws();
    });

    $('lotto-prev-page').addEventListener('click', function () { if (currentPage > 1) { currentPage--; renderDraws(); } });
    $('lotto-next-page').addEventListener('click', function () { currentPage++; renderDraws(); });

    var LOTTO_API_BASE_URL = 'https://rest.dev.pe.kr';
    var PAGE_LIMIT = 10000;

    function toDrawDto(row) {
        return {
            drawNo: Number(row.draw_no || 0),
            drawDate: row.draw_date || '',
            num1: Number(row.num1 || 0),
            num2: Number(row.num2 || 0),
            num3: Number(row.num3 || 0),
            num4: Number(row.num4 || 0),
            num5: Number(row.num5 || 0),
            num6: Number(row.num6 || 0),
            bonusNum: Number(row.bonus_num || 0),
            winnerCount: Number(row.winner_count || 0),
            prizeAmount: Number(row.prize_amount || 0)
        };
    }

    function fetchAllDrawsFromRest() {
        var draws = [];
        function fetchPage(offset) {
            var url = LOTTO_API_BASE_URL + '/tables/lotto_draw?limit=' + PAGE_LIMIT + '&offset=' + offset + '&order_by=draw_no&order=desc';
            return fetch(url)
                .then(function (res) {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(function (data) {
                    var rows = (data && Array.isArray(data.rows)) ? data.rows : [];
                    if (rows.length === 0) {
                        return draws;
                    }
                    rows.forEach(function (row) {
                        draws.push(toDrawDto(row));
                    });
                    var total = Number((data && data.total) || 0);
                    if (rows.length < PAGE_LIMIT || (total > 0 && draws.length >= total)) {
                        return draws;
                    }
                    return fetchPage(offset + rows.length);
                });
        }
        return fetchPage(0);
    }

    function applyDraws(draws) {
        allDraws = draws;
        filteredDraws = draws;
        $('lotto-total-draws').textContent = draws.length.toLocaleString('ko-KR') + '회';
        if (draws[0]) {
            $('lotto-latest-draw').textContent = draws[0].drawNo + '회 (' + draws[0].drawDate + ')';
        }
        computeStats(draws);
        renderDraws();
        renderStats();
        renderRecommendations();
    }

    fetchAllDrawsFromRest()
        .catch(function (err) {
            console.error('rest.dev.pe.kr 로또 당첨번호 조회 실패, 정적 데이터로 대체합니다.', err);
            return fetch('<%- url_for("data/lotto-draws.json") %>')
                .then(function (res) {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                });
        })
        .then(applyDraws)
        .catch(function (err) {
            console.error('로또 당첨번호 데이터를 불러오지 못했습니다.', err);
        });
}());
</script>
