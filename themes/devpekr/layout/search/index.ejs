<div id="search-form-wrap" class="portal-search-wrap">
<% if (theme.search.insight) { %>
    <form class="search-form portal-search-trigger" role="search" onsubmit="return false;">
        <label class="portal-search-label" for="portal-search-input"><span class="portal-sr-only">사이트 검색</span></label>
        <input id="portal-search-input" type="search" class="ins-search-input search-form-input" placeholder="<%= __('index.search') %>" autocomplete="off" />
        <button type="button" class="search-form-submit portal-search-submit" aria-label="검색 열기" onclick="this.form.querySelector('.search-form-input').focus()"><span aria-hidden="true">⌕</span></button>
    </form>
    <%- partial('search/insight') %>
<% } else if (theme.search.swiftype) { %>
    <div class="search-form portal-search-trigger" role="search">
        <label class="portal-search-label" for="portal-search-input"><span class="portal-sr-only">사이트 검색</span></label>
        <input id="portal-search-input" type="search" class="st-default-search-input search-form-input" placeholder="<%= __('index.search') %>" autocomplete="off" />
    </div>
    <%- partial('search/swiftype') %>
<% } else if (theme.search.baidu) { %>
    <%- partial('search/baidu') %>
<% } else { %>
    <div class="portal-search-trigger" role="search"><%- search_form({text: __('index.search')}) %></div>
<% } %>
</div>
