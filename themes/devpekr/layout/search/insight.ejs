<div class="ins-search">
    <div class="ins-search-mask" aria-hidden="true"></div>
    <div class="ins-search-container" role="dialog" aria-modal="true" aria-label="사이트 검색">
        <div class="ins-input-wrapper">
            <input type="search" class="ins-search-input" placeholder="<%= __('insight.hint') %>" aria-label="검색어 입력" autocomplete="off" />
            <button type="button" class="ins-close ins-selectable" aria-label="검색 닫기"><i class="fa fa-times-circle" aria-hidden="true"></i></button>
        </div>
        <div class="ins-section-wrapper">
            <div class="ins-section-container"></div>
        </div>
    </div>
</div>
<script>
(function (window) {
    var INSIGHT_CONFIG = {
        TRANSLATION: {
            POSTS: '<%= __("insight.posts") %>',
            PAGES: '<%= __("insight.pages") %>',
            CATEGORIES: '<%= __("insight.categories") %>',
            TAGS: '<%= __("insight.tags") %>',
            UNTITLED: '<%= __("insight.untitled") %>',
        },
        ROOT_URL: '<%= config.root %>',
        CONTENT_URL: '<%- url_for("/content.json")%>',
    };
    window.INSIGHT_CONFIG = INSIGHT_CONFIG;
})(window);
</script>
<%- js('js/insight') %>
